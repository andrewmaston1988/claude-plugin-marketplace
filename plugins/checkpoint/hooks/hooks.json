{
  "hooks": {
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-compact-snapshot.mjs\"" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt-submit-checkpoint.mjs\"" } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-checkpoint.mjs\"" } ] }
    ],
    "PreToolUse": [
      { "matcher": "^(Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Agent|Workflow|SendMessage|CronCreate|RemoteTrigger|PushNotification|EnterWorktree|Artifact.*|mcp__.*)$", "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/state-guard.mjs\"" } ] }
    ],
    "SessionStart": [
      { "matcher": "startup|clear", "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start-resume.mjs\"" } ] },
      { "matcher": "compact", "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start-compact.mjs\"" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-checkpoint.mjs\"" } ] }
    ]
  }
}
