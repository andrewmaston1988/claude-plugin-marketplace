{
  "provider": {
    "name": "ollama",
    "mode": "env",
    "discoverCmd": "ollama launch claude",
    "launchCmd": "ollama launch claude --model {model} -- {args}",
    "cloudSuffix": ":cloud",
    "allowedRoots": [],
    "url": "http://localhost:11434",
    "catalogUrl": "https://ollama.com",
    "authToken": "ollama"
  },
  "concurrency": 4,
  "timeoutMs": 3600000,
  "heartbeatSecs": 15,
  "quietWarnSecs": 60,
  "retry": {
    "rateLimited": 2,
    "backoffMs": 30000,
    "spawnError": 1
  },
  "quotaPreflight": true,
  "quotaWarnPct": 80,
  "quotaCacheSecs": 300,
  "quotaPatterns": [
    "usage limit reached",
    "out of extra usage",
    "hit your limit",
    "limit will reset"
  ],
  "modelDenylist": [],
  "resultInlineCap": 4000,
  "worktreeBranchPrefix": "swarm/",
  "notifyCmd": null,
  "dashboard": {
    "enabled": true,
    "port": 7331,
    "bind": "0.0.0.0",
    "token": null,
    "recentMs": 1800000
  },
  "swarm": {
    "always": false,
    "workflowNudge": true
  }
}
